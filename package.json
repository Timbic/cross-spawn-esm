{
	"name": "cross-spawn-esm",
	"type": "module",
	"version": "0.0.1",
	"description": "ESM version of cross-spawn package",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"cross-spawn",
		"spawn",
		"spawnSync",
		"windows",
		"cross-platform",
		"path-ext",
		"shebang",
		"cmd",
		"execute"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/cross-spawn-esm.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"prepare": "husky"
	},
	"devDependencies": {
		"@timbic/eslint-config": "1.2.0",
		"@timbic/prettier-config": "1.1.4",
		"bumpp": "12.2.2",
		"eslint": "10.9.1",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"prettier": "3.9.6",
		"tsdown": "0.22.14",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*/**/*.{js,ts,md,json}": [
			"pnpm fmt",
			"pnpm lint:fix"
		]
	},
	"packageManager": "pnpm@11.22.0"
}
