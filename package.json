{
	"name": "cross-spawn-esm",
	"type": "module",
	"version": "2.0.0-beta.1",
	"description": "ESM version of cross-spawn package",
	"author": "Timur Bikmuhametov <tim.bic22@gmail.com>",
	"license": "MIT",
	"keywords": [
		"cross-spawn",
		"spawn",
		"spawnSync",
		"windows",
		"cross-platform",
		"path-ext",
		"shebang",
		"cmd",
		"execute"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timbic/cross-spawn-esm.git"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"SECURITY.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"fmt": "prettier --cache --write .",
		"fmt:chk": "prettier --check .",
		"lint": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"release": "bumpp",
		"prepare": "husky"
	},
	"devDependencies": {
		"@timbic/eslint-config": "1.2.2",
		"@timbic/prettier-config": "1.2.4",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"bumpp": "12.3.0",
		"eslint": "10.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"tsdown": "0.23.2",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"lint-staged": {
		"*.{js,ts,md,json}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"packageManager": "pnpm@12.14.0"
}
